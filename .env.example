# Copia este archivo como .env y completa los valores.
# Los valores salen de Supabase -> tu proyecto -> botón "Connect" -> "Session pooler".
# Si la contraseña tiene caracteres especiales (@ : / ? # % &), va codificada para URL.

# Pooler de SESIÓN (puerto 5432). La usa la app en tiempo de ejecución.
# socket_timeout: una conexión muerta (p. ej. tras cambiar de Wi-Fi) falla a los 30 s en vez de colgarse.
DATABASE_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=5&pool_timeout=10&connect_timeout=10&socket_timeout=30"

# La usa Prisma para crear/actualizar tablas (db push).
DIRECT_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Acceso a la app. NO se escriben a mano: los genera `npm.cmd run clave`.
APP_PASSWORD_HASH=""
SESSION_SECRET=""
