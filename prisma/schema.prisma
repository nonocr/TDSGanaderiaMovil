// Esquema de datos de la App de Ganado.
// Sigue docs/03-modelo-de-datos.md. Solo se guardan hechos con fecha; lo derivado (etapa
// actual, estado reproductivo, pendientes) se calcula en src/lib. Monta != parto.
// Los "enums" se guardan como String (valores válidos en src/lib/validar.ts).

generator client {
  provider = "prisma-client-js"
}

// Base de datos: PostgreSQL en Supabase (ver docs/10-supabase.md).
// DATABASE_URL -> pooler de sesión (puerto 5432) con tiempos límite, lo usa la app.
// DIRECT_URL   -> pooler de sesión sin parámetros extra, lo usa `prisma db push`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ANIMAL -----------------------------------------------------------------
// Datos basicos/permanentes. La genealogia es DERIVADA de padre/madre.
// Un progenitor puede ser un Animal registrado (padreId/madreId) O externo (texto).
model Animal {
  id             String   @id @default(cuid())
  arete          String   @unique
  nombre         String?
  sexo           String   // "MACHO" | "HEMBRA"
  raza           String?
  fechaNacimiento DateTime?
  fotoUrl        String?   // foto (JPEG base64, máx. 600 px), re-codificada en el servidor
  fotoMiniatura  String?   // miniatura (JPEG base64, 160 px, ~10 KB) para listas y encabezados
  descripcion    String?
  estado         String   @default("ACTIVO") // "ACTIVO" | "VENDIDO" | "MUERTO"

  // Módulo al que pertenece el animal. No se mueve entre módulos (regla de negocio).
  // "ENGORDE"     -> crías de la finca, producción de carne (van todas aquí, sin importar sexo).
  // "LECHERIA"    -> vacas de leche (se compran; no nacen en la finca).
  // "REPRODUCTOR" -> el toro de la finca y los toros/semen externos usados para preñar.
  modulo         String   @default("ENGORDE") // "ENGORDE" | "LECHERIA" | "REPRODUCTOR"

  // Código del reproductor (toro/semen). Opcional; se usa sobre todo en el módulo REPRODUCTOR.
  codigo         String?

  // Arete oficial de SENASA (trazabilidad ganadera de Costa Rica). Opcional, para cualquier
  // módulo (engorde, lechería o reproductor). No es único ni obligatorio: no todos los animales
  // lo tienen y es independiente del `arete` interno de la finca.
  // (La columna conserva el nombre histórico `areteCenasa`; en pantalla se muestra "SENASA".)
  areteCenasa    String?

  // El animal NO tiene arete físico de la finca. Como `arete` es obligatorio y único (y lo usa
  // toda la app como identificador), cuando sinArete=true el backend pone en `arete` un valor
  // interno autogenerado único (p. ej. "S/N-xxxx") que el usuario nunca ve: en pantalla se
  // muestra el `areteCenasa` (que en ese caso es obligatorio). Default false.
  sinArete       Boolean  @default(false)

  // Solo hembras de LECHERÍA: "NOVILLA" (aún no ha parido) | "VACA". Null = sin indicar
  // (registros anteriores). Al registrar su primer parto, una novilla pasa sola a VACA.
  categoria      String?

  // Solo en el módulo REPRODUCTOR: distingue una PAJILLA (semen) de un TORO físico.
  // Una pajilla no tiene arete propio: en su alta solo se captura el código, y el backend
  // guarda arete = codigo (el arete es obligatorio y único). Default false (es un toro).
  esPajilla      Boolean  @default(false)

  // Datos de baja (solo cuando estado = VENDIDO o MUERTO). Opcionales.
  fechaBaja      DateTime?
  motivoBaja     String?

  // Genealogia: progenitor registrado (auto-relacion)
  padreId        String?
  padre          Animal?  @relation("PadreHijos", fields: [padreId], references: [id])
  madreId        String?
  madre          Animal?  @relation("MadreHijos", fields: [madreId], references: [id])

  hijosComoPadre Animal[] @relation("PadreHijos")
  hijosComoMadre Animal[] @relation("MadreHijos")

  // Genealogia: progenitor externo (no registrado en el sistema)
  padreExterno   String?
  madreExterno   String?

  // Eventos / historial
  montasComoVaca Monta[]  @relation("MontaVaca")
  montasComoToro Monta[]  @relation("MontaToro")
  partosComoVaca Parto[]  @relation("PartoVaca")
  partosComoToro Parto[]  @relation("PartoToro")
  nacidoEnParto  Cria[]
  registrosLeche RegistroLeche[]
  registrosPeso  RegistroPeso[]
  etapas         EtapaTernero[]
  palpaciones    Palpacion[]
  cambiosEstadoRepro CambioEstadoReproductivo[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Índices: Postgres no indexa solas las claves foráneas.
  // Los listados filtran por sexo/estado o modulo/estado y SIEMPRE ordenan por `arete` asc, así que
  // `arete` va al final del índice: cubre filtro + orden y evita que Postgres ordene en memoria.
  @@index([padreId])
  @@index([madreId])
  @@index([sexo, estado, arete])
  @@index([modulo, estado, arete])
}

// --- MONTA ------------------------------------------------------------------
// Evento. NO implica prenez ni parto.
model Monta {
  id       String   @id @default(cuid())
  vacaId   String
  vaca     Animal   @relation("MontaVaca", fields: [vacaId], references: [id])
  toroId   String
  toro     Animal   @relation("MontaToro", fields: [toroId], references: [id])
  fecha    DateTime
  notas    String?

  // Confirmación de preñez por palpación (B1). Opcional. HISTÓRICO: desde 2026-10-16 la
  // palpación se registra aparte (modelo Palpacion); estos campos se conservan y se muestran.
  prenezConfirmada    Boolean  @default(false)
  fechaConfirmacion   DateTime?

  // La monta fue por inseminación con pajilla (semen) en vez de monta natural del toro.
  inseminacion        Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([vacaId, fecha])
  @@index([toroId])
}

// --- PARTO ------------------------------------------------------------------
// Evento. Puede producir varias crias. El toro/padre es opcional (B3).
model Parto {
  id          String   @id @default(cuid())
  vacaId      String
  vaca        Animal   @relation("PartoVaca", fields: [vacaId], references: [id])
  toroId      String?
  toro        Animal?  @relation("PartoToro", fields: [toroId], references: [id])
  fecha       DateTime
  descripcion String?

  // Datos del nacimiento (B4). Opcionales. Para una cría; con gemelos aplican a la principal.
  criaSana          Boolean?
  necesitoAyuda     Boolean?
  pesoNacimientoKg  Float?

  crias       Cria[]
  createdAt   DateTime @default(now())

  @@index([vacaId, fecha])
  @@index([toroId])
}

// Relaciona un parto con cada cria (Animal) que resulto de el.
model Cria {
  id       String  @id @default(cuid())
  partoId  String
  parto    Parto   @relation(fields: [partoId], references: [id], onDelete: Cascade)
  criaId   String
  cria     Animal  @relation(fields: [criaId], references: [id])

  @@index([partoId])
  @@index([criaId])
}

// --- PRODUCCION DE LECHE ----------------------------------------------------
// Historico, no se sobrescribe. Cada registro es UN ORDEÑO (no el total del día).
// Una vaca se ordeña ~2 veces al día: mañana y tarde. El total del día = suma de sus ordeños.
model RegistroLeche {
  id       String   @id @default(cuid())
  vacaId   String
  vaca     Animal   @relation(fields: [vacaId], references: [id])
  fecha    DateTime
  cantidad Float    // litros de ESE ordeño
  turno    String?  // "MANANA" | "TARDE" (opcional; registros viejos sin turno = total del día)
  notas    String?
  createdAt DateTime @default(now())

  @@index([vacaId, fecha])
}

// --- PESO -------------------------------------------------------------------
model RegistroPeso {
  id       String   @id @default(cuid())
  animalId String
  animal   Animal   @relation(fields: [animalId], references: [id])
  fecha    DateTime
  pesoKg   Float
  notas    String?
  createdAt DateTime @default(now())

  @@index([animalId, fecha])
}

// --- PALPACIÓN --------------------------------------------------------------
// Revisión de la vaca por palpación (fecha + notas). Evento propio, independiente de la monta.
model Palpacion {
  id       String   @id @default(cuid())
  vacaId   String
  vaca     Animal   @relation(fields: [vacaId], references: [id])
  fecha    DateTime
  notas    String?
  createdAt DateTime @default(now())

  @@index([vacaId, fecha])
}

// --- CAMBIO MANUAL DEL ESTADO REPRODUCTIVO -----------------------------------
// El estado reproductivo se DERIVA de montas y partos (src/lib/estado.ts). Cada fila es un cambio
// hecho a mano en una vaca de lechería; el último manda hasta que se registre una monta o un
// parto después de él. estadoNuevo = null -> vuelve al cálculo automático.
model CambioEstadoReproductivo {
  id             String   @id @default(cuid())
  vacaId         String
  vaca           Animal   @relation(fields: [vacaId], references: [id])
  fecha          DateTime @default(now()) // momento del cambio (automático)
  estadoAnterior String?  // estado que tenía al cambiarlo (null = sin estado)
  estadoNuevo    String?  // null = volver al cálculo automático
  descripcion    String?

  @@index([vacaId, fecha])
}

// --- ETAPAS DEL TERNERO -----------------------------------------------------
// HISTÓRICO: desde 2026-10-16 la etapa de engorde se calcula sola por la edad
// (src/lib/estado.ts, etapaPorEdad). Estas filas manuales se conservan como historial.
model EtapaTernero {
  id         String   @id @default(cuid())
  animalId   String
  animal     Animal   @relation(fields: [animalId], references: [id])
  etapa      String   // "LACTANCIA" | "DESARROLLO" | "ENGORDE" ("DESTETE" solo en datos antiguos)
  fechaInicio DateTime
  fechaFin   DateTime?
  notas      String?
  createdAt  DateTime @default(now())

  @@index([animalId])
}

// --- SEGURIDAD --------------------------------------------------------------
// Intentos fallidos de login por IP. Se guarda en la base (no en memoria) porque en
// Vercel cada petición puede atenderla una instancia distinta.
model IntentoLogin {
  ip     String   @id
  fallos Int      @default(0)
  hasta  DateTime? // bloqueado hasta esta fecha
}
