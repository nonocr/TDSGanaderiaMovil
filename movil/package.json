{
  "name": "tds-ganaderia-movil",
  "version": "1.0.0",
  "private": true,
  "description": "App Android de TDS Ganadería (Capacitor). Carga la web publicada en Vercel.",
  "scripts": {
    "iconos": "capacitor-assets generate --android --iconBackgroundColor #ffffff --iconBackgroundColorDark #1c1917 --splashBackgroundColor #ffffff --splashBackgroundColorDark #1c1917",
    "sync": "cap sync android",
    "abrir": "cap open android",
    "apk": "cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
